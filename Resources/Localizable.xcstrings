    "import.cloudNotice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Note: If you select files from iCloud Drive or other cloud storage that are 'cloud-only', iOS will briefly use network to download them and may prompt for cellular data usage. This is system behavior for downloading cloud files, not app-initiated network requests."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提示：如果您从 iCloud Drive 或其他云盘中选择「仅保存在云端」的文件，iOS 系统会为下载该文件短暂使用网络，并可能弹出「是否允许使用无线数据」提示。这属于系统为帮您下载云端文件触发的网络行为，本应用自身不会主动发起任何网络请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提示：如果您從 iCloud Drive 或其他雲端硬碟中選擇「僅儲存在雲端」的檔案，iOS 系統會為下載該檔案短暫使用網路，並可能彈出「是否允許使用無線資料」提示。這屬於系統為幫您下載雲端檔案觸發的網路行為，本應用自身不會主動發起任何網路請求。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "注意：iCloud Driveなどのクラウドストレージで、クラウドにのみ保存されたファイルを選択すると、iOSがダウンロードのため一時的にネットワークを使用し、モバイルデータ通信の確認を表示する場合があります。これはクラウドファイルを取得するシステムの動作であり、アプリが開始する通信ではありません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uwaga: jeśli wybierzesz pliki z iCloud Drive lub innej chmury dostępne tylko online, iOS na krótko użyje sieci, aby je pobrać, i może zapytać o dane komórkowe. To działanie systemu podczas pobierania plików z chmury, a nie żądanie sieciowe aplikacji."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinweis: Wenn du Dateien aus iCloud Drive oder anderen Cloudspeichern auswählst, die nur in der Cloud liegen, verwendet iOS kurzzeitig das Netzwerk zum Herunterladen und fragt eventuell nach der Mobilfunknutzung. Dies ist Systemverhalten beim Laden von Cloud-Dateien und keine Netzwerkanfrage der App."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remarque : si vous sélectionnez des fichiers uniquement dans le cloud depuis iCloud Drive ou un autre stockage cloud, iOS utilise brièvement le réseau pour les télécharger et peut demander l’accès aux données cellulaires. Il s’agit du téléchargement système des fichiers cloud, et non de requêtes réseau de l’app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nota: si seleccionas archivos que solo están en iCloud Drive u otro almacenamiento en la nube, iOS usará brevemente la red para descargarlos y puede solicitar el uso de datos móviles. Es una función del sistema para descargar archivos de la nube, no una solicitud de red de la app."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nota: se você selecionar arquivos que estão apenas no iCloud Drive ou em outro serviço de nuvem, o iOS usará brevemente a rede para baixá-los e poderá solicitar o uso de dados celulares. Esse é um comportamento do sistema para baixar arquivos da nuvem, não uma solicitação de rede do app."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Catatan: jika Anda memilih file yang hanya ada di cloud dari iCloud Drive atau penyimpanan cloud lain, iOS akan menggunakan jaringan sebentar untuk mengunduhnya dan mungkin meminta penggunaan data seluler. Ini adalah tindakan sistem untuk mengunduh file cloud, bukan permintaan jaringan dari aplikasi."
          }
        }
      }
    },
