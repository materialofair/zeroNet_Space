    "disguise.confirmChange.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After changing password, you'll need to use the new password for next login. Encrypted files will continue using the original key, no reencryption needed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "修改主密码后，下次登录需要使用新密码。加密文件会继续使用最初设置的密钥，无需等待重新加密。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "修改主密碼後，下次登入需要使用新密碼。加密檔案會繼續使用最初設定的金鑰，無需等待重新加密。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワードを変更すると、次回のログインには新しいパスワードが必要になります。暗号化済みファイルは元の鍵を使用するため、再暗号化は不要です。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po zmianie hasła przy następnym logowaniu użyj nowego hasła. Zaszyfrowane pliki zachowają pierwotny klucz; ponowne szyfrowanie nie jest potrzebne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach der Passwortänderung benötigst du beim nächsten Anmelden das neue Passwort. Verschlüsselte Dateien verwenden weiterhin den ursprünglichen Schlüssel; eine erneute Verschlüsselung ist nicht nötig."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après le changement, utilisez le nouveau mot de passe à la prochaine connexion. Les fichiers chiffrés conservent leur clé d’origine et n’ont pas besoin d’être chiffrés à nouveau."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras cambiar la contraseña, tendrás que usar la nueva al iniciar sesión. Los archivos cifrados seguirán usando la clave original, sin necesidad de volver a cifrarlos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Após alterar a senha, use a nova senha no próximo acesso. Os arquivos criptografados continuarão usando a chave original, sem precisar de nova criptografia."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setelah mengubah kata sandi, gunakan kata sandi baru saat masuk berikutnya. File terenkripsi tetap menggunakan kunci asli tanpa perlu dienkripsi ulang."
          }
        }
      }
    },
