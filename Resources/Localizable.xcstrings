        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清理快取可釋放臨時檔案佔用的空間，不會刪除您的私密檔案"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャッシュを消去すると、一時ファイルの領域を解放できます。プライベートファイルは削除されません"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyczyszczenie pamięci podręcznej zwolni miejsce zajmowane przez pliki tymczasowe, bez usuwania prywatnych plików"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Leeren des Caches gibt temporären Speicher frei, ohne deine privaten Dateien zu löschen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vider le cache libère l’espace des fichiers temporaires sans supprimer vos fichiers privés"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaciar la caché libera espacio temporal sin eliminar tus archivos privados"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpar o cache libera espaço de arquivos temporários sem excluir seus arquivos privados"
