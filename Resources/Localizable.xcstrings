    "appicon.error.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not change the icon. Please try again while the app is open."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图标更换失败，请保持应用在前台后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圖示更換失敗，請保持應用在前台後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アイコンを変更できませんでした。アプリを開いたまま再試行してください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zmienić ikony. Spróbuj ponownie, gdy aplikacja jest otwarta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Symbol konnte nicht geändert werden. Versuche es erneut, während die App geöffnet ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de changer l’icône. Réessayez en gardant l’app ouverte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cambiar el icono. Inténtalo de nuevo con la app abierta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível alterar o ícone. Tente novamente com o app aberto."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikon tidak dapat diubah. Coba lagi saat aplikasi terbuka."
          }
        }
      }
    },
    "appicon.error.unsupported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device does not support changing app icons."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前设备不支持更换应用图标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當前設備不支持更換應用圖示。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスではアプリアイコンを変更できません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To urządzenie nie obsługuje zmiany ikon aplikacji."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät unterstützt das Ändern von App-Symbolen nicht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil ne permet pas de changer les icônes d’app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo no permite cambiar los iconos de las apps."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo não permite alterar ícones de apps."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perangkat ini tidak mendukung perubahan ikon aplikasi."
          }
        }
      }
    },
    "appicon.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can restore the default icon for free at any time. Changing the icon does not change the app name, login mode or data protection. iOS displays a confirmation after the change."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随时可以免费恢复默认图标。更换图标不会更改应用名称、登录方式或数据保护。更换后，iOS 会显示系统提示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隨時可以免費恢復預設圖示。更換圖示不會更改應用名稱、登入方式或資料保護。更換後，iOS 會顯示系統提示。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いつでも無料で初期アイコンに戻せます。アイコンを変更しても、アプリ名、ログインモード、データ保護は変わりません。変更後にiOSの確認が表示されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz w każdej chwili bezpłatnie przywrócić domyślną ikonę. Zmiana ikony nie zmienia nazwy aplikacji, trybu logowania ani ochrony danych. Po zmianie iOS wyświetla potwierdzenie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst jederzeit kostenlos zum Standardsymbol zurückkehren. Die Symboländerung ändert weder den App-Namen noch den Anmeldemodus oder den Datenschutz. iOS zeigt nach der Änderung eine Bestätigung an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez rétablir gratuitement l’icône par défaut à tout moment. Changer l’icône ne modifie ni le nom de l’app, ni le mode de connexion, ni la protection des données. iOS affiche une confirmation après le changement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes restaurar el icono predeterminado gratis en cualquier momento. Cambiar el icono no cambia el nombre de la app, el modo de acceso ni la protección de datos. iOS muestra una confirmación tras el cambio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode restaurar o ícone padrão gratuitamente a qualquer momento. Alterar o ícone não muda o nome do app, o modo de acesso ou a proteção dos dados. O iOS exibe uma confirmação após a alteração."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda dapat memulihkan ikon default secara gratis kapan saja. Mengubah ikon tidak mengubah nama aplikasi, mode masuk, atau perlindungan data. iOS menampilkan konfirmasi setelah perubahan."
          }
        }
      }
    },
