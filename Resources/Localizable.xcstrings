        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Encrypted on this device · Leaving ends and saves your recording"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在本机加密保存 · 离开时自动结束并保存录音"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅在本機加密儲存 · 離開時自動結束並儲存錄音"
