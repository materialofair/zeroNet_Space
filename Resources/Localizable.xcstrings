    "calculatorLogin.security.tips": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "• Calculator interface is fully realistic and undetectable • No calculation history is retained • Please memorize your password sequence"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "• 计算器界面完全真实，无法被识破 • 不会保留任何计算历史记录 • 请牢记您的密码序列"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "• 計算器介面完全真實，無法被識破 • 不會保留任何計算歷史記錄 • 請牢記您的密碼序列"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "• 本物の電卓と変わらない自然な画面 • 計算履歴は保存されません • パスワード入力列を忘れないでください"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "• Interfejs kalkulatora jest realistyczny i nierozpoznawalny • Historia obliczeń nie jest zapisywana • Zapamiętaj sekwencję hasła"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "• Die Rechner-Oberfläche wirkt vollständig echt und ist nicht als Tarnung erkennbar • Es wird kein Rechenverlauf gespeichert • Merke dir deine Passwortfolge"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "• L’interface de calculatrice est réaliste et indétectable • Aucun historique de calcul n’est conservé • Mémorisez votre séquence de déverrouillage"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "• La interfaz de calculadora es totalmente realista e indetectable • No se conserva historial de cálculos • Memoriza tu secuencia de contraseña"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "• A interface da calculadora é totalmente realista e indetectável • Nenhum histórico de cálculo é mantido • Memorize sua sequência de senha"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "• Antarmuka kalkulator sepenuhnya realistis dan tidak terdeteksi • Riwayat perhitungan tidak disimpan • Ingat urutan kata sandi Anda"
          }
        }
      }
    },
