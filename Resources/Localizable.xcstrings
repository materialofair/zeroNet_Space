    "auth.error.disguiseMismatch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The disguise password does not match the main password. Please sign in again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计算器登录密码与主密码不一致，请重新登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "計算器登入密碼與主密碼不一致，請重新登入。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "偽装パスワードがメインパスワードと一致しません。もう一度ログインしてください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasło kamuflażu nie pasuje do hasła głównego. Zaloguj się ponownie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Tarnpasswort stimmt nicht mit dem Hauptpasswort überein. Melde dich erneut an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mot de passe leurre ne correspond pas au mot de passe principal. Reconnectez-vous."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La contraseña de camuflaje no coincide con la principal. Inicia sesión de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A senha de disfarce não corresponde à senha principal. Entre novamente."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kata sandi penyamaran tidak cocok dengan kata sandi utama. Silakan masuk kembali."
          }
        }
      }
    },
