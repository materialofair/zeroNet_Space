        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer el audio seleccionado. Vuelve a elegir el archivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler o áudio selecionado. Escolha o arquivo novamente."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio yang dipilih tidak dapat dibaca. Pilih file lagi."
          }
        }
      }
    },
    "audio.error.importCount": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld of %2$lld audio files could not be imported. The others were saved. Check the format, file integrity and available storage."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld / %2$lld 个音频导入失败。其余文件已保存，请检查格式、文件完整性和可用空间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld / %2$lld 個音訊匯入失敗。其餘檔案已儲存，請檢查格式、檔案完整性和可用空間。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld件の音声ファイルのうち%1$lld件を読み込めませんでした。ほかのファイルは保存されました。形式、ファイルの破損、空き容量を確認してください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zaimportować %1$lld z %2$lld plików audio. Pozostałe zapisano. Sprawdź format, integralność plików i wolne miejsce."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Audioimport: %1$lld von %2$lld fehlgeschlagen. Die übrigen wurden gespeichert. Prüfe Format, Dateiintegrität und verfügbaren Speicher."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Import audio : échec pour %1$lld sur %2$lld. Le reste a été enregistré. Vérifiez le format, l’intégrité des fichiers et l’espace disponible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importación de audio: errores en %1$lld de %2$lld. El resto se guardó. Revisa el formato, la integridad de los archivos y el espacio disponible."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Importação de áudio: falha em %1$lld de %2$lld. O restante foi salvo. Verifique o formato, a integridade dos arquivos e o espaço disponível."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld dari %2$lld file audio tidak dapat diimpor. File lainnya telah disimpan. Periksa format, integritas file, dan ruang penyimpanan yang tersedia."
          }
        }
      }
    },
    "audio.error.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use 1–200 characters without slashes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名称应为 1–200 个字符，且不能包含斜杠。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "名稱應為 1–200 個字元，且不能包含斜槓。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スラッシュを含めず、1～200文字にしてください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj od 1 do 200 znaków bez ukośników."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende 1–200 Zeichen ohne Schrägstriche."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez 1 à 200 caractères, sans barres obliques."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa entre 1 y 200 caracteres, sin barras."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use de 1 a 200 caracteres, sem barras."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan 1–200 karakter tanpa garis miring."
          }
        }
      }
    },
    "audio.error.permission": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Microphone access is disabled. Allow microphone access for this app in Settings, then try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "麦克风权限未开启。请在系统「设置」中允许本应用访问麦克风后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "麥克風權限未開啓。請在系統「設定」中允許本應用訪問麥克風後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクへのアクセスが無効です。設定でこのアプリのマイク使用を許可し、再試行してください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostęp do mikrofonu jest wyłączony. Zezwól tej aplikacji na używanie mikrofonu w Ustawieniach i spróbuj ponownie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Mikrofonzugriff ist deaktiviert. Erlaube dieser App den Zugriff in den Einstellungen und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès au microphone est désactivé. Autorisez-le pour cette app dans Réglages, puis réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso al micrófono está desactivado. Permítelo para esta app en Ajustes e inténtalo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso ao microfone está desativado. Permita o acesso para este app em Ajustes e tente novamente."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses mikrofon dinonaktifkan. Izinkan akses mikrofon untuk aplikasi ini di Pengaturan, lalu coba lagi."
          }
        }
      }
    },
    "audio.error.playback": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to play this audio. Try again or check whether the file is damaged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法播放此音频，请重试或检查文件是否受损。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法播放此音訊，請重試或檢查檔案是否受損。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この音声を再生できません。再試行するか、ファイルが破損していないか確認してください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można odtworzyć tego nagrania. Spróbuj ponownie lub sprawdź, czy plik nie jest uszkodzony."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Audio kann nicht abgespielt werden. Versuche es erneut oder prüfe, ob die Datei beschädigt ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire cet audio. Réessayez ou vérifiez si le fichier est endommagé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede reproducir este audio. Inténtalo de nuevo o comprueba si el archivo está dañado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível reproduzir este áudio. Tente novamente ou verifique se o arquivo está danificado."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio ini tidak dapat diputar. Coba lagi atau periksa apakah file rusak."
          }
        }
      }
    },
    "audio.error.recording": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording could not continue. Check your microphone and available storage. You can try saving the audio already recorded."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法继续录音。请检查麦克风和可用空间，您可以尝试保存已录制的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法繼續錄音。請檢查麥克風和可用空間，您可以嘗試儲存已錄制的內容。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音を継続できませんでした。マイクと空き容量を確認してください。すでに録音した音声の保存を試すことができます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można kontynuować nagrywania. Sprawdź mikrofon i wolne miejsce. Możesz spróbować zapisać już nagrany dźwięk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufnahme konnte nicht fortgesetzt werden. Prüfe Mikrofon und freien Speicher. Du kannst versuchen, das bereits aufgenommene Audio zu speichern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de poursuivre l’enregistrement. Vérifiez le microphone et l’espace disponible. Vous pouvez essayer de sauvegarder l’audio déjà enregistré."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo continuar la grabación. Revisa el micrófono y el espacio disponible. Puedes intentar guardar el audio ya grabado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível continuar a gravação. Verifique o microfone e o espaço disponível. Você pode tentar salvar o áudio já gravado."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekaman tidak dapat dilanjutkan. Periksa mikrofon dan ruang penyimpanan yang tersedia. Anda dapat mencoba menyimpan audio yang sudah direkam."
          }
        }
      }
    },
    "audio.error.save": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not save. Check available storage and retry. Unsaved audio is still available on this screen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存失败，请检查可用空间后重试。未保存的录音仍保留在当前页面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存失敗，請檢查可用空間後重試。未儲存的錄音仍保留在當前頁面。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存できませんでした。空き容量を確認して再試行してください。未保存の音声は、この画面で引き続き利用できます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zapisać nagrania. Sprawdź wolne miejsce i spróbuj ponownie. Niezapisane nagranie jest nadal dostępne na tym ekranie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichern nicht möglich. Prüfe den freien Speicher und versuche es erneut. Ungespeichertes Audio ist auf diesem Bildschirm weiterhin verfügbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrement impossible. Vérifiez l’espace disponible et réessayez. L’audio non enregistré reste disponible sur cet écran."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar. Revisa el espacio disponible e inténtalo de nuevo. El audio sin guardar sigue disponible en esta pantalla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar. Verifique o espaço disponível e tente novamente. O áudio não salvo continua disponível nesta tela."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat menyimpan. Periksa ruang yang tersedia lalu coba lagi. Audio yang belum disimpan masih tersedia di layar ini."
          }
        }
      }
    },
