    "settings.changePassword.warning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changing your password will re-encrypt all files with the new password. This process may take a while, please keep the app open until it completes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "修改密码将使用新密码重新加密所有文件，这个过程可能需要较长时间，请保持应用打开直到完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "修改密碼將使用新密碼重新加密所有檔案，這個過程可能需要較長時間，請保持應用打開直到完成。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワードを変更すると、すべてのファイルが新しいパスワードで再暗号化されます。時間がかかる場合があるため、完了するまでアプリを開いたままにしてください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiana hasła spowoduje ponowne zaszyfrowanie wszystkich plików nowym hasłem. Może to potrwać. Pozostaw aplikację otwartą do zakończenia."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Ändern deines Passworts werden alle Dateien mit dem neuen Passwort erneut verschlüsselt. Das kann etwas dauern. Lass die App bis zum Abschluss geöffnet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le changement de mot de passe chiffre à nouveau tous les fichiers avec le nouveau mot de passe. Cela peut prendre du temps. Gardez l’app ouverte jusqu’à la fin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al cambiar la contraseña, todos los archivos se cifrarán de nuevo con ella. Puede tardar un poco; mantén la app abierta hasta que termine."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao alterar sua senha, todos os arquivos serão criptografados novamente com a nova senha. Isso pode demorar; mantenha o app aberto até terminar."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengubah kata sandi akan mengenkripsi ulang semua file dengan kata sandi baru. Proses ini mungkin memerlukan waktu. Biarkan aplikasi terbuka hingga selesai."
          }
        }
      }
    },
