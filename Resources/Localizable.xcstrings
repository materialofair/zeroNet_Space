    "audio.share.vipRequired.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sharing audio recordings is a VIP exclusive feature. Please unlock VIP in Settings to share recordings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音分享为 VIP 会员专享功能。请在“设置”中升级解锁 VIP 后使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄音分享為 VIP 會員專享功能。請在“設定”中升級解鎖 VIP 後使用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音の共有はVIP限定機能です。共有するには設定でVIPを解除してください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Udostępnianie nagrań jest funkcją VIP. Odblokuj VIP w ustawieniach, aby udostępniać nagrania."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Teilen von Audioaufnahmen ist eine exklusive VIP-Funktion. Schalte VIP in den Einstellungen frei, um Aufnahmen zu teilen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le partage d’enregistrements audio est réservé à VIP. Débloquez VIP dans Réglages pour partager vos enregistrements."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartir grabaciones de audio es una función exclusiva de VIP. Desbloquea VIP en Ajustes para compartirlas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartilhar gravações de áudio é uma função exclusiva do VIP. Desbloqueie o VIP em Ajustes para compartilhar gravações."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berbagi rekaman audio adalah fitur eksklusif VIP. Buka VIP di Pengaturan untuk berbagi rekaman."
          }
        }
      }
    },
