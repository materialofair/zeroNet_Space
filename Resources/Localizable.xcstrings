    "disguise.passwordSetup.instruction1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please set a new password with only numbers and decimal point"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请设置一个仅包含数字和小数点的新密码"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請設定一個僅包含數字和小數點的新密碼"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "数字と小数点のみで新しいパスワードを設定してください"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustaw nowe hasło zawierające tylko cyfry i kropkę dziesiętną"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege ein neues Passwort nur aus Ziffern und Dezimalpunkten fest"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définissez un nouveau mot de passe composé uniquement de chiffres et de points décimaux"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una nueva contraseña que solo contenga números y puntos decimales"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina uma nova senha com apenas números e pontos decimais"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tetapkan kata sandi baru yang hanya berisi angka dan titik desimal"
          }
        }
      }
    },
    "disguise.passwordSetup.instruction2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After changing, you'll need to reimport files (old files will be undecryptable)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "修改后，需要重新导入文件（旧文件将无法解密）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "修改後，需要重新匯入檔案（舊檔案將無法解密）"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更後はファイルの再読み込みが必要です（以前のファイルは復号できなくなります）"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po zmianie trzeba będzie ponownie zaimportować pliki (starych plików nie da się odszyfrować)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach der Änderung musst du Dateien erneut importieren (alte Dateien lassen sich nicht mehr entschlüsseln)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après le changement, vous devrez réimporter les fichiers (les anciens ne pourront plus être déchiffrés)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras el cambio, tendrás que importar los archivos de nuevo (los antiguos ya no podrán descifrarse)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Após a alteração, será necessário importar os arquivos novamente (os antigos não poderão ser descriptografados)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setelah perubahan, file harus diimpor ulang (file lama tidak dapat didekripsi)."
          }
        }
      }
    },
    "disguise.passwordSetup.rule1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only supports numbers (0-9) and decimal point (.)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
