    "iap.limitExceeded.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You exceeded the free import limit. Delete files or unlock unlimited imports to continue."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您已超过免费导入限制。请删除一些文件或解锁无限导入后再继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您已超過免費匯入限制。請刪除一些檔案或解鎖無限匯入後再繼續。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料の読み込み上限を超えました。ファイルを削除するか、無制限の読み込みを解除して続行してください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przekroczono bezpłatny limit importu. Usuń pliki lub odblokuj import bez limitu, aby kontynuować."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast das kostenlose Importlimit überschritten. Lösche Dateien oder schalte unbegrenzte Importe frei, um fortzufahren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez dépassé la limite d’imports gratuits. Supprimez des fichiers ou débloquez les imports illimités pour continuer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has superado el límite de importaciones gratuitas. Elimina archivos o desbloquea importaciones ilimitadas para continuar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você ultrapassou o limite de importações gratuitas. Exclua arquivos ou desbloqueie importações ilimitadas para continuar."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda telah melampaui batas impor gratis. Hapus file atau buka impor tanpa batas untuk melanjutkan."
          }
        }
      }
    },
    "iap.limitReached.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free import limit reached. Unlock unlimited imports to keep adding media."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已达到免费导入上限。解锁无限导入以继续添加媒体。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已達到免費匯入上限。解鎖無限匯入以繼續添加媒體。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料の読み込み上限に達しました。さらにメディアを追加するには、無制限の読み込みを購入してください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Osiągnięto bezpłatny limit importu. Odblokuj import bez limitu, aby dodawać kolejne multimedia."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das kostenlose Importlimit ist erreicht. Schalte unbegrenzte Importe frei, um weitere Medien hinzuzufügen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La limite d’imports gratuits est atteinte. Débloquez les imports illimités pour ajouter d’autres médias."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has alcanzado el límite de importaciones gratuitas. Desbloquea importaciones ilimitadas para añadir más archivos multimedia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite de importações gratuitas atingido. Desbloqueie importações ilimitadas para adicionar mais mídias."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Batas impor gratis tercapai. Buka impor tanpa batas untuk menambahkan media lagi."
          }
        }
      }
    },
