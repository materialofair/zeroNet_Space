          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changement de mot de passe requis"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Debes cambiar la contraseña"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alteração de senha necessária"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perubahan kata sandi diperlukan"
          }
        }
      }
    },
    "calculatorLogin.enable.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, the app will launch with calculator interface instead of login screen"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后，应用启动时将显示计算器界面而非登录界面"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啓用後，應用啓動時將顯示計算器介面而非登入介面"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効にすると、ログイン画面の代わりに電卓画面で起動します"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po włączeniu aplikacja uruchamia się jako kalkulator zamiast ekranu logowania"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aktiviert, startet die App mit dem Rechner statt dem Anmeldebildschirm"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois activé, l’app s’ouvre sur la calculatrice plutôt que sur l’écran de connexion"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al activarlo, la app mostrará la calculadora en lugar de la pantalla de acceso"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando ativado, o app abre com a calculadora em vez da tela de acesso"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat aktif, aplikasi akan terbuka dengan antarmuka kalkulator, bukan layar masuk"
          }
        }
      }
    },
    "calculatorLogin.enable.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When calculator login mode is enabled, the app launches as a calculator. Set a password sequence to unlock the real interface."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用计算器登录模式后，应用将以计算器界面启动。请设置一个密码序列用于解锁应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啓用計算器登入模式後，應用將以計算器介面啓動。請設定一個密碼序列用於解鎖應用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "電卓ログインモードを有効にすると、アプリは電卓として起動します。実際の画面を解除するパスワード入力列を設定してください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po włączeniu trybu logowania przez kalkulator aplikacja uruchamia się jako kalkulator. Ustaw sekwencję hasła, aby odblokować właściwy interfejs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn die Rechner-Anmeldung aktiviert ist, startet die App als Rechner. Lege eine Passwortfolge fest, um die eigentliche Oberfläche zu entsperren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En mode calculatrice, l’app s’ouvre comme une calculatrice. Définissez une séquence de déverrouillage pour accéder à l’interface principale."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando activas el acceso con calculadora, la app se inicia como una calculadora. Configura una secuencia de contraseña para desbloquear la interfaz real."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando o acesso pela calculadora está ativado, o app abre como uma calculadora. Defina uma sequência de senha para desbloquear a interface real."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat mode masuk kalkulator aktif, aplikasi terbuka sebagai kalkulator. Atur urutan kata sandi untuk membuka antarmuka sebenarnya."
          }
        }
      }
    },
