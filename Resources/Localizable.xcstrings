    "iap.unlimitedImport.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock unlimited imports + 🎁 Hidden surprise feature! One-time purchase, lifetime access."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解锁无限导入 + 🎁 隐藏惊喜功能！一次购买，终身使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "解鎖無限匯入 + 🎁 隱藏驚喜功能！一次購買，終身使用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無制限の読み込み＋🎁隠しサプライズ機能を解除！買い切りでずっと利用できます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odblokuj import bez limitu + 🎁 ukrytą funkcję niespodziankę! Jednorazowy zakup, dostęp na zawsze."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unbegrenzte Importe + 🎁 versteckte Überraschungsfunktion freischalten! Einmaliger Kauf, lebenslanger Zugriff."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Débloquez les imports illimités + 🎁 une fonction surprise cachée ! Achat unique, accès à vie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Desbloquea importaciones ilimitadas + 🎁 una función sorpresa oculta! Compra única, acceso de por vida."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloqueie importações ilimitadas + 🎁 uma função surpresa oculta! Compra única, acesso vitalício."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka impor tanpa batas + 🎁 fitur kejutan tersembunyi! Pembelian satu kali, akses seumur hidup."
          }
        }
      }
    },
