    "settings.feature.offline.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Works entirely offline so nothing ever leaves your device"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完全离线运行，数据绝不离开设备"
