    "settings.changePassword.calculatorLoginHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Calculator Login Mode is enabled: Password must only contain numbers (0-9) and decimal points (.)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ 计算器登录模式已启用：密码只能包含数字(0-9)和小数点(.)"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ 計算器登入模式已啓用：密碼只能包含數字(0-9)和小數點(.)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ 電卓ログインモードが有効です。パスワードには数字（0～9）と小数点（.）のみ使用できます"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Włączono tryb logowania przez kalkulator: hasło może zawierać tylko cyfry (0–9) i kropki dziesiętne (.)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Rechner-Anmeldung ist aktiviert: Das Passwort darf nur Ziffern (0–9) und Dezimalpunkte (.) enthalten"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Le mode calculatrice est activé : le mot de passe ne peut contenir que des chiffres (0–9) et des points décimaux (.)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Acceso con calculadora activado: la contraseña solo puede contener números (0–9) y puntos decimales (.)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Acesso pela calculadora ativado: a senha deve conter apenas números (0–9) e pontos decimais (.)"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Mode masuk kalkulator aktif: kata sandi hanya boleh berisi angka (0–9) dan titik desimal (.)"
          }
        }
      }
    },
