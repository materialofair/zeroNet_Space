        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete this item? This action cannot be undone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确定删除此项目吗？此操作无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確定刪除此項目嗎？此操作無法撤銷。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この項目を削除しますか？この操作は取り消せません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunąć ten element? Tej operacji nie można cofnąć."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Element löschen? Das kann nicht rückgängig gemacht werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer cet élément ? Cette action est irréversible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar este elemento? Esta acción no se puede deshacer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluir este item? Esta ação não pode ser desfeita."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus item ini? Tindakan ini tidak dapat dibatalkan."
          }
        }
      }
    },
