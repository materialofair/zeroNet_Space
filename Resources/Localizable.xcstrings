    "calculatorLogin.instructions.example": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Example: Enter 1234.56 then press ="
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "示例: 输入 1234.56 再按 ="
          }
        },
        "zh-Hant": {
