    "guestMode.setup.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a decoy password - when someone uses it, they'll see an empty app (perfect for privacy protection!)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建一个计算器登录密码 - 当有人使用它时，会看到一个空应用（隐私保护利器！）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "建立一個計算器登入密碼 - 當有人使用它時，會看到一個空應用（隱私保護利器！）"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "おとりのパスワードを作成します。このパスワードで開くと、空のアプリが表示されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utwórz hasło pozorne — po jego użyciu aplikacja będzie wyglądać na pustą."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle ein Tarnpasswort: Wer es verwendet, sieht eine leere App – ideal zum Schutz deiner Privatsphäre!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez un mot de passe leurre : les personnes qui l’utilisent voient une app vide, idéale pour protéger votre vie privée !"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una contraseña señuelo: quien la use verá una app vacía, ¡ideal para proteger tu privacidad!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie uma senha de disfarce: quem usá-la verá um app vazio, ideal para proteger sua privacidade!"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buat kata sandi penyamaran: orang yang menggunakannya akan melihat aplikasi kosong, cocok untuk menjaga privasi!"
          }
        }
      }
    },
