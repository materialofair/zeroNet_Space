        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ 内购功能需要网络访问。购买时请开启网络。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ 內購功能需要網路訪問。購買時請開啓網路。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ アプリ内購入にはネットワークアクセスが必要です。購入時はネットワークを有効にしてください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Zakupy w aplikacji wymagają dostępu do sieci. Włącz sieć podczas zakupu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ In-App-Käufe benötigen Netzwerkzugriff. Aktiviere das Netzwerk beim Kaufen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Les achats intégrés nécessitent le réseau. Activez-le lors d’un achat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Las compras dentro de la app requieren acceso a la red. Actívalo al comprar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ As compras no app exigem acesso à rede. Ative a rede ao comprar."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Pembelian dalam aplikasi memerlukan akses jaringan. Aktifkan jaringan saat membeli."
          }
        }
      }
    },
    "network.import.cloud.notice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Selecting cloud files will trigger iOS system downloads (not app networking)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ 选择云端文件会触发iOS系统下载（非应用联网）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ 選擇雲端檔案會觸發iOS系統下載（非應用連網）"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ クラウドファイルを選ぶとiOSのダウンロードが行われます（アプリによる通信ではありません）"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Wybór plików z chmury uruchamia pobieranie przez iOS (nie przez aplikację)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Die Auswahl von Cloud-Dateien löst iOS-Systemdownloads aus (keine Netzwerkaktivität der App)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Sélectionner des fichiers cloud déclenche un téléchargement système iOS (pas une activité réseau de l’app)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Seleccionar archivos de la nube inicia descargas del sistema iOS (no conexiones de la app)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Selecionar arquivos da nuvem inicia downloads do sistema iOS (não conexões do app)"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Memilih file cloud akan memicu unduhan sistem iOS (bukan jaringan aplikasi)"
          }
        }
      }
    },
