    "settings.storage.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clearing cache will free up temporary file storage without deleting your private files"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清理缓存可释放临时文件占用的空间，不会删除您的私密文件"
