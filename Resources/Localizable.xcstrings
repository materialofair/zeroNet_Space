    "login.privacy.description": {
      "comment": "Privacy statement description",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local Encrypted Storage • Zero Network Transfer • Open Source Auditable"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地加密存储 • 零网络传输 • 开源可审计"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本地加密儲存 • 零網路傳輸 • 開源可審計"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカル暗号化保存 • ネットワーク転送なし • オープンソースで検証可能"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokalne szyfrowanie • Bez przesyłania przez sieć • Otwarty kod do weryfikacji"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokaler verschlüsselter Speicher • Keine Netzwerkübertragung • Prüfbarer Open Source"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stockage local chiffré • Aucun transfert réseau • Code ouvert auditable"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Almacenamiento local cifrado • Cero transferencias por red • Código abierto auditable"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Armazenamento local criptografado • Zero transferência pela rede • Código aberto auditável"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penyimpanan lokal terenkripsi • Tanpa transfer jaringan • Sumber terbuka yang dapat diaudit"
          }
        }
      }
    },
    "login.privacy.networkNotice": {
      "comment": "Network notice message in login screen",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app will never make network requests. Any network request you see is from the system (except for in-app purchases). You can safely deny network access."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本应用不会发起网络请求，如遇到网络请求均为系统发起（内购除外），可放心拒绝。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本應用不會發起網路請求，如遇到網路請求均為系統發起（內購除外），可放心拒絕。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリはネットワークリクエストを行いません。表示される通信はシステムによるものです（アプリ内購入を除く）。ネットワークアクセスは拒否しても問題ありません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta aplikacja nie wysyła żądań sieciowych. Widoczne połączenia pochodzą z systemu (z wyjątkiem zakupów w aplikacji). Możesz bezpiecznie odmówić dostępu do sieci."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese App stellt nie Netzwerkanfragen. Alle sichtbaren Netzwerkanfragen stammen vom System (außer In-App-Käufen). Du kannst den Netzwerkzugriff sicher verweigern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette app n’effectue jamais de requêtes réseau. Toute requête visible provient du système (sauf les achats intégrés). Vous pouvez refuser l’accès au réseau sans problème."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta app nunca realiza solicitudes de red. Cualquier solicitud que veas procede del sistema (excepto las compras dentro de la app). Puedes denegar el acceso a la red con seguridad."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este app nunca faz solicitações de rede. Qualquer solicitação visível vem do sistema (exceto compras no app). Você pode negar o acesso à rede com segurança."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi ini tidak pernah membuat permintaan jaringan. Setiap permintaan jaringan yang Anda lihat berasal dari sistem (kecuali pembelian dalam aplikasi). Anda dapat menolak akses jaringan dengan aman."
          }
        }
      }
    },
