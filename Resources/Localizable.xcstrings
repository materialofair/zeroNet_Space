    "audio.delete.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This audio will be permanently deleted. This cannot be undone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此音频将被永久删除，无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此音訊將被永久刪除，無法撤銷。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この録音を完全に削除します。この操作は取り消せません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To nagranie zostanie trwale usunięte. Nie można tego cofnąć."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Audio wird endgültig gelöscht. Das kann nicht rückgängig gemacht werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet audio sera définitivement supprimé. Cette action est irréversible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este audio se eliminará permanentemente. Esta acción no se puede deshacer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este áudio será excluído permanentemente. Esta ação não pode ser desfeita."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio ini akan dihapus permanen. Tindakan ini tidak dapat dibatalkan."
          }
        }
      }
    },
