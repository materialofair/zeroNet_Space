    "network.promise.exceptions.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "• iOS system file picker downloads • Apple StoreKit in-app purchases\n\nThese are system-level operations required by iOS, not app networking."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "• iOS系统文件选择器下载 • Apple StoreKit内购功能\n\n这些是iOS系统级操作要求，非应用联网。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "• iOS系統檔案選擇器下載 • Apple StoreKit內購功能\n\n這些是iOS系統級操作要求，非應用連網。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "• iOSシステムのファイル選択によるダウンロード • Apple StoreKitのアプリ内購入\n\nこれらはiOSが必要とするシステムレベルの操作であり、アプリによる通信ではありません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "• Pobieranie przez systemowy wybór plików iOS • Zakupy w aplikacji przez Apple StoreKit\n\nTo operacje systemowe wymagane przez iOS, a nie połączenia sieciowe aplikacji."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "• Downloads über die iOS-Dateiauswahl • Apple StoreKit-In-App-Käufe\n\nDies sind von iOS benötigte Systemvorgänge, keine Netzwerkaktivität der App."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "• Téléchargements via le sélecteur de fichiers iOS • Achats intégrés Apple StoreKit\n\nCe sont des opérations système nécessaires à iOS, et non une activité réseau de l’app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "• Descargas del selector de archivos de iOS • Compras dentro de la app con Apple StoreKit\n\nSon operaciones del sistema necesarias para iOS, no conexiones de red de la app."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "• Downloads pelo seletor de arquivos do iOS • Compras no app pelo Apple StoreKit\n\nSão operações do sistema necessárias ao iOS, não conexões de rede do app."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "• Unduhan pemilih file sistem iOS • Pembelian dalam aplikasi Apple StoreKit\n\nIni adalah operasi tingkat sistem yang diperlukan iOS, bukan jaringan aplikasi."
          }
        }
      }
    },
    "network.promise.normal": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Normal usage is 100% offline - you can safely disable network access for daily use."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日常使用100%离线 - 平时可以放心关闭网络访问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "日常使用100%離線 - 平時可以放心關閉網路訪問。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通常の利用は完全にオフラインです。日常的な利用ではネットワークアクセスを無効にしても問題ありません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwykłe korzystanie odbywa się w 100% offline — na co dzień możesz bezpiecznie wyłączyć dostęp do sieci."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die normale Nutzung erfolgt zu 100% offline. Du kannst den Netzwerkzugriff im Alltag sicher deaktivieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’usage courant est 100% hors ligne. Vous pouvez désactiver l’accès au réseau au quotidien sans problème."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El uso normal es 100% sin conexión. Puedes desactivar el acceso a la red con seguridad para el uso diario."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O uso normal é 100% offline. Você pode desativar o acesso à rede com segurança no dia a dia."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penggunaan biasa 100% offline. Anda dapat menonaktifkan akses jaringan dengan aman untuk penggunaan sehari-hari."
          }
        }
      }
    },
