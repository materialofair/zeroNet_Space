    "audio.error.cleanup": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporary files could not be removed. Reopen the app and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "临时文件清理失败，请重新打开应用后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "臨時檔案清理失敗，請重新打開應用後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一時ファイルを削除できませんでした。アプリを開き直してお試しください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się usunąć plików tymczasowych. Otwórz aplikację ponownie i spróbuj jeszcze raz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporäre Dateien konnten nicht entfernt werden. Öffne die App erneut und versuche es nochmals."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de supprimer les fichiers temporaires. Rouvrez l’app et réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron eliminar los archivos temporales. Vuelve a abrir la app e inténtalo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível remover os arquivos temporários. Reabra o app e tente novamente."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File sementara tidak dapat dihapus. Buka ulang aplikasi lalu coba lagi."
          }
        }
      }
    },
