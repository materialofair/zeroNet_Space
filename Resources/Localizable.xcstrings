    "calculatorLogin.changePassword.required.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculator Login mode requires main password to contain only numbers and decimal point. Current password contains letters or special characters. Please change to numbers and decimal point only."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计算器登录模式要求主密码仅包含数字和小数点。当前主密码包含字母或特殊字符，请修改为仅包含数字和小数点的密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "計算器登入模式要求主密碼僅包含數字和小數點。當前主密碼包含字母或特殊字元，請修改為僅包含數字和小數點的密碼。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "電卓ログインには、数字と小数点のみのメインパスワードが必要です。現在のパスワードには文字または特殊記号が含まれています。数字と小数点のみに変更してください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Logowanie przez kalkulator wymaga hasła głównego zawierającego tylko cyfry i kropkę dziesiętną. Obecne hasło zawiera litery lub znaki specjalne. Zmień je na hasło złożone wyłącznie z cyfr i kropki."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Rechner-Anmeldung erfordert ein Hauptpasswort nur aus Ziffern und Dezimalpunkten. Dein aktuelles Passwort enthält Buchstaben oder Sonderzeichen. Ändere es entsprechend."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mode calculatrice exige un mot de passe principal composé uniquement de chiffres et de points décimaux. Le mot de passe actuel contient des lettres ou des caractères spéciaux. Modifiez-le en conséquence."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso con calculadora requiere una contraseña principal que solo contenga números y puntos decimales. La actual contiene letras o caracteres especiales. Cámbiala para cumplir este requisito."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso pela calculadora exige uma senha principal com apenas números e pontos decimais. A senha atual contém letras ou caracteres especiais. Altere-a para atender a esse requisito."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mode masuk kalkulator memerlukan kata sandi utama yang hanya berisi angka dan titik desimal. Kata sandi saat ini berisi huruf atau karakter khusus. Ubah agar hanya berisi angka dan titik desimal."
          }
        }
      }
    },
    "calculatorLogin.changePassword.required.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
