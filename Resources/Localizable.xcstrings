    "calculatorLogin.passwordSequence.autoSyncHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Password sequence automatically syncs with your main password. Change your main password to update the calculator login mode unlock sequence."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密码序列自动与主密码同步。修改主密码即可更新计算器登录模式解锁序列。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "密碼序列自動與主密碼同步。修改主密碼即可更新計算器登入模式解鎖序列。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワード入力列はメインパスワードと自動的に同期されます。メインパスワードを変更すると、電卓ログインモードの解除に使う入力列も更新されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekwencja hasła automatycznie synchronizuje się z hasłem głównym. Zmień hasło główne, aby zaktualizować sekwencję odblokowania trybu logowania przez kalkulator."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Passwortfolge wird automatisch mit deinem Hauptpasswort synchronisiert. Ändere dein Hauptpasswort, um die Entsperrfolge der Rechner-Anmeldung zu aktualisieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La séquence se synchronise automatiquement avec votre mot de passe principal. Modifiez ce dernier pour mettre à jour la séquence de déverrouillage du mode calculatrice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La secuencia se sincroniza automáticamente con tu contraseña principal. Cámbiala para actualizar la secuencia de desbloqueo del acceso con calculadora."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sequência é sincronizada automaticamente com sua senha principal. Altere a senha principal para atualizar a sequência de desbloqueio do acesso pela calculadora."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Urutan kata sandi disinkronkan otomatis dengan kata sandi utama. Ubah kata sandi utama untuk memperbarui urutan pembuka kunci mode masuk kalkulator."
          }
        }
      }
    },
