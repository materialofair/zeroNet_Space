    "markdown.help.bold.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wrap text with ** to make it bold"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 ** 包裹文字以加粗"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 ** 包裹文字以加粗"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "** で囲むと太字になります"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otocz tekst znakami **, aby go pogrubić"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Umschließe Text mit **, um ihn fett zu schreiben"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entourez le texte de ** pour le gras"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rodea el texto con ** para ponerlo en negrita"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envolva o texto com ** para usar negrito"
