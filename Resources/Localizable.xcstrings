    "appicon.vip.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "VIP includes all alternate icons, unlimited imports and audio sharing. Existing VIP members can use these icons at no extra cost. After unlocking, tap your preferred icon to apply it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "VIP 包含全部专属图标、无限导入和录音分享。已购买 VIP 的用户无需重复付费。解锁后，点击喜欢的图标即可更换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "VIP 包含全部專屬圖示、無限匯入和錄音分享。已購買 VIP 的使用者無需重複付費。解鎖後，點選喜歡的圖示即可更換。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "VIPにはすべての追加アイコン、無制限の読み込み、録音共有が含まれます。既存のVIPユーザーは追加料金なしでこれらのアイコンを使用できます。解除後、使いたいアイコンをタップして適用してください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "VIP obejmuje wszystkie dodatkowe ikony, import bez limitu i udostępnianie nagrań. Obecni użytkownicy VIP mogą korzystać z tych ikon bez dodatkowych opłat. Po odblokowaniu stuknij wybraną ikonę, aby ją zastosować."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "VIP enthält alle alternativen Symbole, unbegrenzte Importe und Audiofreigabe. Bestehende VIP-Mitglieder können die Symbole ohne Aufpreis nutzen. Tippe nach dem Freischalten auf dein gewünschtes Symbol, um es anzuwenden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "VIP inclut toutes les icônes alternatives, les imports illimités et le partage audio. Les membres VIP existants peuvent utiliser ces icônes sans frais supplémentaires. Après déblocage, touchez l’icône de votre choix pour l’appliquer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "VIP incluye todos los iconos alternativos, importaciones ilimitadas y compartir audio. Los miembros actuales de VIP pueden usar estos iconos sin coste adicional. Tras desbloquearlos, toca el icono que prefieras para aplicarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O VIP inclui todos os ícones alternativos, importações ilimitadas e compartilhamento de áudio. Quem já é membro VIP pode usar os ícones sem custo extra. Após desbloquear, toque no ícone desejado para aplicá-lo."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "VIP mencakup semua ikon alternatif, impor tanpa batas, dan berbagi audio. Anggota VIP yang sudah ada dapat menggunakan ikon ini tanpa biaya tambahan. Setelah dibuka, ketuk ikon pilihan Anda untuk menerapkannya."
          }
        }
      }
    },
    "appicon.vip.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All four alternate icons are included with VIP. Already a member? They’re yours."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "四款专属图标已包含在 VIP 权益中，老用户无需重复购买。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "四款專屬圖示已包含在 VIP 權益中，老使用者無需重複購買。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "4種類の代替アイコンはすべてVIPに含まれます。すでに会員の方はそのまま利用できます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie cztery dodatkowe ikony są dostępne w VIP. Masz już VIP? Możesz ich używać."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle vier alternativen Symbole sind in VIP enthalten. Bereits Mitglied? Dann gehören sie dir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les quatre icônes alternatives sont incluses dans VIP. Déjà membre ? Elles sont à vous."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cuatro iconos alternativos están incluidos en VIP. ¿Ya eres miembro? Ya los tienes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os quatro ícones alternativos estão incluídos no VIP. Já é membro? Eles já são seus."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Keempat ikon alternatif termasuk dalam VIP. Sudah menjadi anggota? Semuanya sudah tersedia untuk Anda."
          }
        }
      }
    },
