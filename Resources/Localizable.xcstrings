        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "数字（0～9）と小数点（.）のみ使用できます"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsługuje tylko cyfry (0–9) i kropkę dziesiętną (.)"
          }
        },
        "de": {
