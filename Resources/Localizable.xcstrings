    "network.technical.encryption": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All encryption operations are completed locally on device, keys never leave the device"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有加密操作均在设备本地完成，密钥从不离开设备"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有加密操作均在設備本地完成，金鑰從不離開設備"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "暗号化はすべてデバイス内で行われ、鍵がデバイスの外に出ることはありません"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szyfrowanie odbywa się lokalnie na urządzeniu, a klucze nigdy go nie opuszczają"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gesamte Verschlüsselung erfolgt lokal auf dem Gerät; Schlüssel verlassen es nie"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les opérations de chiffrement se font sur l’appareil ; les clés ne le quittent jamais"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo el cifrado se realiza en el dispositivo; las claves nunca salen de él"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda a criptografia é feita no dispositivo; as chaves nunca saem dele"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua proses enkripsi dilakukan di perangkat; kunci tidak pernah keluar dari perangkat"
          }
        }
      }
    },
    "network.technical.guarantee": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Code-level guarantee: No network capability = Cannot leak data"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代码级保证：没有网络能力 = 无法泄露数据"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "代碼級保證：沒有網路能力 = 無法洩露資料"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードによる保証：ネットワーク機能がなければ、ネットワーク経由でデータを送信できません"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gwarancja na poziomie kodu: bez obsługi sieci dane nie mogą być przesyłane przez sieć"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Garantie im Code: Keine Netzwerkfunktion = Keine Datenlecks"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garantie dans le code : pas de fonction réseau = pas de fuite de données"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Garantía en el código: sin función de red = sin filtraciones de datos"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Garantia no código: sem função de rede = sem vazamento de dados"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaminan pada kode: tanpa kemampuan jaringan = data tidak dapat bocor"
          }
        }
      }
    },
    "network.technical.storage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All files are encrypted and stored in app's private directory, inaccessible to other apps"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有文件加密后存储在应用私有目录，其他应用无法访问"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有檔案加密後儲存在應用私有目錄，其他應用無法訪問"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルはすべて暗号化され、アプリ専用の領域に保存されるため、ほかのアプリからアクセスできません"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie pliki są zaszyfrowane i przechowywane w prywatnym katalogu aplikacji, niedostępnym dla innych aplikacji"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Dateien werden verschlüsselt im privaten App-Verzeichnis gespeichert und sind für andere Apps unzugänglich"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les fichiers sont chiffrés et stockés dans le répertoire privé de l’app, inaccessible aux autres apps"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los archivos se cifran y guardan en el directorio privado de la app, inaccesible para otras apps"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os arquivos são criptografados e salvos na pasta privada do app, inacessível a outros apps"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua file dienkripsi dan disimpan dalam direktori pribadi aplikasi yang tidak dapat diakses aplikasi lain"
          }
        }
      }
    },
