        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You'll need to re-enter your password to access private content after logging out"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出后需要重新输入密码才能访问私密内容"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "退出後需要重新輸入密碼才能訪問私密內容"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
