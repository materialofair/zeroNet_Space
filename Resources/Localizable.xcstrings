    "network.iap.alert.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In-app purchases require network connection. Please enable network access in Settings to continue."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内购功能需要网络连接。请在设置中开启网络访问以继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "內購功能需要網路連接。請在設定中開啓網路訪問以繼續。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリ内購入にはネットワーク接続が必要です。設定でネットワークアクセスを有効にして続けてください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakupy w aplikacji wymagają połączenia z siecią. Włącz dostęp do sieci w Ustawieniach, aby kontynuować."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In-App-Käufe benötigen eine Netzwerkverbindung. Aktiviere den Netzwerkzugriff in den Einstellungen, um fortzufahren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les achats intégrés nécessitent une connexion réseau. Activez l’accès au réseau dans Réglages pour continuer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las compras dentro de la app requieren conexión a la red. Activa el acceso a la red en Ajustes para continuar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As compras no app exigem conexão de rede. Ative o acesso à rede em Ajustes para continuar."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembelian dalam aplikasi memerlukan koneksi jaringan. Aktifkan akses jaringan di Pengaturan untuk melanjutkan."
          }
        }
      }
    },
