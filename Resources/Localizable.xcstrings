    "login.forgotPasswordWarning": {
      "comment": "Warning message about password reset",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For security reasons, the password cannot be reset. You need to uninstall and reinstall the app, but all data will be lost."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由于安全原因，密码无法重置。您需要卸载应用并重新安装，但所有数据将会丢失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由於安全原因，密碼無法重置。您需要移除應用並重新安裝，但所有資料將會丟失。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安全上の理由から、パスワードはリセットできません。アプリの削除と再インストールが必要ですが、すべてのデータが失われます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ze względów bezpieczeństwa hasła nie można zresetować. Trzeba odinstalować i ponownie zainstalować aplikację, co spowoduje utratę wszystkich danych."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus Sicherheitsgründen kann das Passwort nicht zurückgesetzt werden. Du musst die App deinstallieren und erneut installieren; dabei gehen alle Daten verloren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour des raisons de sécurité, le mot de passe ne peut pas être réinitialisé. Vous devez désinstaller et réinstaller l’app, ce qui effacera toutes les données."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por seguridad, no se puede restablecer la contraseña. Tendrás que desinstalar y reinstalar la app, pero se perderán todos los datos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por segurança, a senha não pode ser redefinida. Será necessário desinstalar e reinstalar o app, mas todos os dados serão perdidos."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Demi keamanan, kata sandi tidak dapat direset. Anda harus menghapus lalu memasang ulang aplikasi, tetapi semua data akan hilang."
          }
        }
      }
    },
