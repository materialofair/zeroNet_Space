        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尝试次数过多，请在 %1$d 分 %2$d 秒后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "嘗試次數過多，請在 %1$d 分 %2$d 秒後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
