    "import.encryptedFile.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file will be re-encrypted with your current password after successful decryption."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解密成功后，文件将使用当前密码重新加密。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "解密成功後，檔案將使用當前密碼重新加密。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復号後、現在のパスワードでファイルを再暗号化します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po odszyfrowaniu plik zostanie ponownie zaszyfrowany obecnym hasłem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach erfolgreicher Entschlüsselung wird die Datei mit deinem aktuellen Passwort erneut verschlüsselt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après déchiffrement, le fichier sera chiffré à nouveau avec votre mot de passe actuel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras descifrarse correctamente, el archivo se volverá a cifrar con tu contraseña actual."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Após a descriptografia, o arquivo será criptografado novamente com sua senha atual."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setelah berhasil didekripsi, file akan dienkripsi ulang dengan kata sandi Anda saat ini."
          }
        }
      }
    },
    "import.encryptedFile.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file was encrypted with a different password. Please enter the original password used to encrypt this file."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件使用不同的密码加密。请输入加密此文件时使用的原始密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此檔案使用不同的密碼加密。請輸入加密此檔案時使用的原始密碼。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルは別のパスワードで暗号化されています。暗号化時に使用した元のパスワードを入力してください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten plik zaszyfrowano innym hasłem. Wpisz oryginalne hasło użyte do zaszyfrowania pliku."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei wurde mit einem anderen Passwort verschlüsselt. Gib das ursprüngliche Passwort ein, mit dem sie verschlüsselt wurde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
